# ---------------------------------------------------------------------------
# NEXUS configuration template. Copy to .env (never commit .env).
# Every value here is a placeholder or a safe default. No real credentials.
# ---------------------------------------------------------------------------

# development | test | production
NEXUS_ENV=development
# API + built web app listen address. Use 0.0.0.0 only behind a trusted proxy/preview.
NEXUS_HOST=127.0.0.1
NEXUS_PORT=8787
# Public origin used for cookies, CORS and the GitHub OAuth callback.
NEXUS_PUBLIC_ORIGIN=http://localhost:8787

# Directory for the SQLite database, workspaces, engine state and artifacts.
NEXUS_DATA_DIR=./data

# 32-byte key, base64 encoded, used to encrypt provider keys and GitHub tokens.
# REQUIRED in production. In development NEXUS generates one into NEXUS_DATA_DIR/.secret-key.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXUS_ENCRYPTION_KEY=

# Allow new account registration (first registered account becomes admin).
NEXUS_ALLOW_REGISTRATION=true

# Coding-agent engine (OpenCode). Path to the opencode binary; empty = bundled node_modules binary.
NEXUS_OPENCODE_BIN=
# Maximum concurrently running OpenCode server processes.
NEXUS_MAX_ENGINES=2
# Idle minutes before an OpenCode server process is stopped.
NEXUS_ENGINE_IDLE_MINUTES=15

# Command sandbox: "namespace" (Linux user/mount/net namespaces) or "disabled" (commands refused).
NEXUS_SANDBOX_MODE=namespace
NEXUS_JOB_TIMEOUT_SECONDS=300
NEXUS_JOB_MEMORY_MB=4096

# Per-user quotas (per UTC day).
NEXUS_QUOTA_AGENT_MESSAGES_PER_DAY=200
NEXUS_QUOTA_COMMANDS_PER_DAY=500

# GitHub OAuth App (optional). Create at https://github.com/settings/developers.
# Callback URL: ${NEXUS_PUBLIC_ORIGIN}/api/github/oauth/callback
NEXUS_GITHUB_CLIENT_ID=
NEXUS_GITHUB_CLIENT_SECRET=
